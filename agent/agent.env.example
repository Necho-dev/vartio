# 出站连 Vartio Hub。GUEST_CONTROL_URL / GUEST_TOKEN 仍然有效。
VARTIO_AGENT_CONTROL_URL=ws://127.0.0.1:8766/v1/probe/connect
VARTIO_AGENT_TOKEN=dev

# 可选。覆盖本机 SMBIOS UUID（本机调试或克隆未重生 bios 时）
# VARTIO_AGENT_BIOS_UUID=423f0000-0000-0000-0000-000000000001

# 可选。健康查询时附带探活
# VARTIO_AGENT_WATCH_PROCS=chrome.exe
# VARTIO_AGENT_WATCH_SERVICES=Spooler
