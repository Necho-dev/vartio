# 出站连 probe-hub（本机 8766）或 vm-server（Guest 能到达的 :8765）
GUEST_CONTROL_URL=ws://127.0.0.1:8766/v1/probe/connect
GUEST_TOKEN=dev

# 可选。覆盖本机 SMBIOS UUID（本机调试或克隆未重生 bios 时）
# GUEST_BIOS_UUID=423f0000-0000-0000-0000-000000000001

# 可选。健康查询时附带探活
# GUEST_WATCH_PROCS=chrome.exe
# GUEST_WATCH_SERVICES=Spooler
